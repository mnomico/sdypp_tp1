# Plantilla de configuración. Copiar a `.env` y ajustar:
#   cp .env.example .env
# El archivo `.env` NO se versiona (ver .gitignore). Nunca poner secrets acá:
# en la nube, las credenciales van por GitHub Secrets / Secret Manager.
#
# Precedencia: argumento de línea de comandos > variable de entorno > default.

# Dirección de escucha. 127.0.0.1 para pruebas locales; 0.0.0.0 al desplegar.
TP1_HOST=127.0.0.1

# Puertos TCP de cada hit
TP1_PUERTO_HIT1=9001
TP1_PUERTO_HIT2=9002
TP1_PUERTO_HIT3=9003
TP1_PUERTO_HIT4=9004
TP1_PUERTO_HIT5=9005
TP1_PUERTO_HIT6=9600
TP1_PUERTO_HIT7=9700

# Parámetros del Nodo D (Hit #6 / Hit #7)
TP1_D_HOST=127.0.0.1
TP1_D_PUERTO=9600
TP1_DURACION_VENTANA=60.0

# Puertos del endpoint HTTP /health.
# El endpoint escucha en la misma interfaz que TP1_HOST: con 127.0.0.1 sólo se
# ve desde la máquina local, y hay que poner 0.0.0.0 para publicarlo.
TP1_PUERTO_HEALTH=8080
TP1_PUERTO_HEALTH_D=8086
TP1_PUERTO_HEALTH_D_HIT7=8087

# Mensaje que A le envía a B
TP1_SALUDO=Hola B, soy A

# Timeout de las operaciones de socket, en segundos
TP1_TIMEOUT=5.0

# Corta un canal entrante que no dice nada durante este tiempo, para que un
# cliente mudo no retenga un hilo del servidor indefinidamente.
TP1_TIMEOUT_INACTIVIDAD=60.0

# Reintentos de A: espera inicial y tope del backoff exponencial, en segundos
TP1_ESPERA_INICIAL=0.5
TP1_ESPERA_MAXIMA=5.0
